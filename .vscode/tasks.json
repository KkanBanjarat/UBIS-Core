{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "node_modules/.bin/vite.cmd",
      "options": { 
        "cwd": "${workspaceFolder}/Frontend/ubis-hr-web"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^\\s*\\[vite\\] Internal server error: (.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v\\d",
          "endsPattern": "ready in"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      // ปิด vite เมื่อ Stop debug เพื่อให้รันรอบหน้าเริ่มใหม่ ไม่ค้างรอ "ready in"
      "label": "frontend: stop",
      "type": "shell",
      "command": "echo ${input:terminateFrontend}",
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    },
    {
      "label": "build: BeHr",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Services/HR/UBIS.HR.Api/UBIS.HR.Api.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: BeAccess",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Services/Access/UBIS.Access.Api/UBIS.Access.Api.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ],
  "inputs": [
    {
      "id": "terminateFrontend",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "frontend: dev"
    }
  ]
}